# Bifrost — sample environment.
#
# Copy to `.env` and adjust values for your environment. `.env` is
# gitignored; never commit real credentials.
#
# Pydantic-settings loads keys with the prefix BIFROST_ — e.g.
# BIFROST_DATABASE_URL maps to BifrostSettings.database_url.

# ── Database ──────────────────────────────────────────────────────
# Local dev: peer-auth Postgres or matching docker-compose.yml.
# Production: rotate from Vault or AWS Secrets Manager; never inline.
BIFROST_DATABASE_URL=postgresql+asyncpg://bifrost:bifrost_dev@localhost:5432/bifrost

# ── API server ────────────────────────────────────────────────────
BIFROST_API_BASE_URL=http://localhost:8000

# ── Logging ───────────────────────────────────────────────────────
BIFROST_LOG_LEVEL=INFO

# ── Claude CLI subprocess ─────────────────────────────────────────
# Auth comes from `claude auth login` (your Claude login). No API key here.
BIFROST_CLAUDE_CLI_PATH=claude
BIFROST_CLAUDE_CLI_TIMEOUT_SECONDS=600

# ── Models ────────────────────────────────────────────────────────
BIFROST_TRIAGE_MODEL=claude-opus-4-8
BIFROST_EXTRACTION_MODEL=claude-sonnet-4-6
BIFROST_AGENT_MODEL=claude-sonnet-4-6
BIFROST_REASONING_MODEL=claude-opus-4-8

# ── Extraction worker ─────────────────────────────────────────────
BIFROST_MAX_CONCURRENT_EXTRACTIONS=1
BIFROST_CHECKPOINT_DIR=/tmp/bifrost-checkpoints
BIFROST_CLONE_DIR=/tmp/bifrost-clones
BIFROST_EXTRACTION_DRY_RUN=false

# ── CLI / CI token ────────────────────────────────────────────────
# The CLI sends this as ``Authorization: Bearer``. Mint one with
# ``bifrost token new`` and list its sha256 under ``api_tokens`` in
# bifrost.yaml on the server.
BIFROST_TOKEN=

# ── External integrations (optional) ──────────────────────────────
# Jira — required if you want the action layer to enrich briefs from
# Jira links in user input.
BIFROST_SOURCES__JIRA__BASE_URL=
BIFROST_SOURCES__JIRA__EMAIL=
BIFROST_SOURCES__JIRA__API_TOKEN=

# ── Process-environment only ──────────────────────────────────────
# These are read from the process environment, not from this file, and
# startup rejects them here. Export them in the shell that starts Bifrost:
#   BIFROST_DISABLE_AUTO_ARCHIVE=1   disable the scheduled archive job
#   BIFROST_EMBEDDING_CACHE=<dir>    embedding model cache folder

# ── Production-strict startup ────────
# When true the app refuses to start if any prod-required secret is
# missing or still on a local-dev default. Set this in any
# deployment that serves real users. Local dev / CI / demo runs
# leave it false (the default).
#
# Required when true:
#   * BIFROST_SESSION_SIGNING_KEY (stable HMAC key)
#   * BIFROST_DATABASE_URL (NOT the localhost default)
#   * BIFROST_CORS_ORIGINS (NOT the localhost default)
#   * identity.provider=header with identity.trusted_proxy=true
#     OR identity.provider=oidc_jwt (see bifrost.example.yaml).
#   * BIFROST_DEMO_MODE must NOT be true.
BIFROST_PRODUCTION_MODE=false

# ── Identity provider ──────────────────────────────────────────────
# Set these under ``identity:`` in bifrost.yaml, or as env vars.
#   BIFROST_IDENTITY__PROVIDER=none | header | oidc_jwt
#
# none (the local operator, loopback clients only):
#   BIFROST_OPERATOR_EMAIL=you@example.com
#   BIFROST_OPERATOR_GROUPS=eng,ops
#
# header (a reverse proxy supplies the identity headers):
#   BIFROST_IDENTITY__PROVIDER=header
#   BIFROST_IDENTITY__TRUSTED_PROXY=true
#
# oidc_jwt (verify bearer JWTs against the IdP signing keys):
#   BIFROST_IDENTITY__PROVIDER=oidc_jwt
#   BIFROST_IDENTITY__OIDC__JWKS_URL=https://idp.example.com/.well-known/jwks.json
#   BIFROST_IDENTITY__OIDC__ISSUER=https://idp.example.com
#   BIFROST_IDENTITY__OIDC__AUDIENCE=bifrost
#
# header and oidc_jwt also need identity.roles (group -> role map) in
# bifrost.yaml.
